# ============================================================
# AceroMAX API — Variables de entorno
# ============================================================
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env a GitHub.

# MercadoPago Credenciales
# Obtener en: https://www.mercadopago.com.mx/developers/panel/app
MP_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
MP_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY

# URL del frontend (sin trailing slash)
FRONTEND_URL=https://aceromax.mx

# URL de esta API (para webhooks)
API_URL=https://aceromax-api.onrender.com

# Notificaciones por correo (Nodemailer + Gmail SMTP)
# Se necesita una "Contraseña de aplicación" de Google:
# → myaccount.google.com/apppasswords
SMTP_USER=acero2@aceromax.mx
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
NOTIFY_EMAIL=acero2@aceromax.mx

# Puerto del servidor
PORT=3001

# Entorno
NODE_ENV=production
